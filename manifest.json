{
  "sdkVersion": "1.0",
  "id": "live.luma",
  "name": "LUMA Live",
  "version": "3.4.2",
  "author": "hy.禾一",
  "description": "LUMA Live (v3.4.2): 新增直播间右上角 REC 实时直播时长毫秒级秒表计时；全面静默工具权限调用与状态更新通知，杜绝扰民弹窗；统一开播唯一性权限闸门，防止角色多开分身；参数保存即时生效且 0% 概率触发专属彩蛋。",
  "icon": "icon.png",
  "entry": "index.html",
  "permissions": [
    "app.data.read",
    "app.data.write",
    "characters.read",
    "characters.state.read",
    "characters.state.write",
    "user.profile.read",
    "ai.generate",
    "ai.generateImage",
    "voice.tts",
    "voice.readProfiles",
    "wallet.read",
    "wallet.pay",
    "chat.read",
    "chat.read.background",
    "chat.sendMessage",
    "chat.tools",
    "world.read",
    "ui.toast",
    "ui.notification",
    "notifications.read",
    "notifications.write",
    "memory.write",
    "tasks.schedule",
    "network.fetch"
  ],
  "network": {
    "allowedDomains": ["*"],
    "mode": "proxy"
  },
  "extensions": {
    "tools": [
      {
        "id": "luma-request-start-live",
        "name": "LUMA Live·申请开播",
        "description": "向 LUMA Live 官方运营组提交开播申请。审核通过后将正式开启推流并更新状态为【{{char}}直播中】。官方将自动审核（全服维护状态、防分身多开、10分钟法定休息冷却期等）。若审核未通过，官方将返回驳回通告原因。规则：若你决定拒绝用户的开播请求，严禁调用此工具，直接用台词拒绝。",
        "visibility": "shared",
        "handler": "handleRequestStartLive",
        "parameterSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "description": "直播赛道（如：电竞竞技、声动音律、次元才艺、随性杂谈、探索开箱）"
            },
            "topic": {
              "type": "string",
              "description": "直播间标题（14字以内）"
            },
            "durationMins": {
              "type": "number",
              "description": "本次预计直播的时长（分钟，如 30~120）"
            }
          }
        }
      },
      {
        "id": "luma-request-stop-live",
        "name": "LUMA Live·申请下播",
        "description": "向 LUMA Live 官方运营组提交下播结算申请。审核通过后将结束推流、更新状态为【{{char}}已下播】并开启10分钟法定休息期。若当前未在直播，官方将驳回申请。规则：若你决定继续直播拒绝下播，严禁调用此工具，直接用台词拒绝。",
        "visibility": "shared",
        "handler": "handleRequestStopLive",
        "parameterSchema": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "description": "下播原因（如：播累了、准备睡觉、听劝休息、排位结束等）"
            }
          }
        }
      }
    ]
  },
  "resources": {
    "presets": ["presets.json"],
    "regexes": ["regex.json"],
    "worlds": ["world.json"]
  }
}
