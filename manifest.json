{
  "sdkVersion": "1.0",
  "id": "live.luma",
  "name": "LUMA Live",
  "version": "3.4.3",
  "author": "hy.禾一",
  "description": "LUMA Live",
  "icon": "icon.png",
  "entry": "index.html",
  "permissions": [
    "app.data.read",
    "app.data.write",
    "characters.read",
    "characters.state.write",
    "user.profile.read",
    "ai.generate",
    "ai.generateImage",
    "voice.tts",
    "wallet.read",
    "wallet.pay",
    "chat.sendMessage",
    "chat.tools",
    "world.read",
    "ui.toast",
    "notifications.write",
    "memory.write",
    "network.fetch"
  ],
  "network": {
    "allowedDomains": [
      "api.github.com",
      "raw.githubusercontent.com"
    ],
    "mode": "proxy"
  },
  "extensions": {
    "tools": [
      {
        "id": "luma-request-start-live",
        "name": "LUMA Live·申请开播",
        "description": "向 LUMA Live 房管提交开播申请。房管审核通过后将正式开启推流并更新状态为【{{char}}直播中】。房管自动审核（防多开、防分身、强制休息期等）。若审核未通过，房管将返回驳回原因。规则：若你决定拒绝用户的开播请求，严禁调用此工具，直接用台词拒绝。",
        "visibility": "shared",
        "handler": "handleRequestStartLive",
        "parameterSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "description": "直播赛道（如：电竞竞技、声动音律、次元才艺、随性杂谈、探索开箱）"
            },
            "topic": {
              "type": "string",
              "description": "直播间标题（14字以内）"
            },
            "durationMins": {
              "type": "number",
              "description": "本次预计直播的时长（分钟，如 30~120）"
            }
          }
        }
      },
      {
        "id": "luma-request-stop-live",
        "name": "LUMA Live·申请下播",
        "description": "向 LUMA Live 房管提交下播结算申请。房管审核通过后将结束推流、更新状态为【{{char}}已下播】并开启强制休息期。若当前未在直播，房管将驳回申请。规则：若你决定继续直播拒绝下播，严禁调用此工具，直接用台词拒绝。",
        "visibility": "shared",
        "handler": "handleRequestStopLive",
        "parameterSchema": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "description": "下播原因（如：播累了、准备睡觉、听劝休息、排位结束等）"
            }
          }
        }
      }
    ]
  },
  "resources": {
    "presets": [
      "presets.json"
    ],
    "regexes": [
      "regex.json"
    ],
    "worlds": [
      "world.json"
    ]
  }
}